# Copy to .env and export before running (uvicorn does not read .env by itself):
#   set -a; source .env; set +a

# Where the executor is reachable from the citizen's phone (used in citizen links)
CIVIC_PUBLIC_URL=http://127.0.0.1:8000
# Shared key for Part 1 / Part 2 calls (header X-API-Key). Empty = no check (local only).
CIVIC_API_KEY=change-me
# HMAC secret for webhooks to callback_url. Share with Part 1 / Part 2.
CIVIC_WEBHOOK_SECRET=change-me-too
# Fernet key for the vault. Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Empty = a key is generated into .data/vault.key on first run.
CIVIC_VAULT_KEY=
CIVIC_VAULT_TTL_S=86400

SANDBOX_URL=http://127.0.0.1:8100
# 1 = fixed OTP 123456 and CAPTCHA 7KQ2M in the sandbox (rehearsals and tests only)
SANDBOX_TEST_MODE=0

# 0 = show the browser window (good for the demo)
CIVIC_HEADLESS=1
CIVIC_STEP_TIMEOUT_MS=20000
CIVIC_HUMAN_TIMEOUT_S=600
CIVIC_APPROVAL_TIMEOUT_S=600

# Claude for repair and AI explore. Use ONE of:
#   AIMLAPI_KEY        Claude through AIML API (provider picked automatically when this is the only key)
#   ANTHROPIC_API_KEY  Anthropic's own API
AIMLAPI_KEY=
ANTHROPIC_API_KEY=
# anthropic | aimlapi (optional; auto-detected from which key is set)
CIVIC_LLM_PROVIDER=
CIVIC_LLM_ENABLED=1
CIVIC_LLM_MODEL=claude-opus-5-5
CIVIC_LLM_EFFORT=low
CIVIC_HEAL_MAX_ACTIONS=25
CIVIC_HEAL_MAX_SECONDS=120

# Teammates' services, shown inside the unified web app (see docs/UI_CONTRACT.md).
# Empty = that part shows an honest "not connected yet" panel.
PART1_API_URL=
PART2_API_URL=

# Agent console (free-form requests at /agent)
# Web search providers, tried in order: duckduckgo (HTML results, no key) and site (the portal's own search page).
CIVIC_SEARCH=duckduckgo,site
CIVIC_CONSOLE_MAX_STEPS=14
CIVIC_CONSOLE_MAX_SECONDS=240
